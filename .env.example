[TEMPLATE]
ACTIVITY_PORT=5009
PRELOAD_MODELS=0
# One container runs everything: the in-container vLLM engine serves Qwen3-VL-8B
# (int4 AWQ) for vision, and the API runs Qwen2-Audio (4-bit NF4) for audio.
# There is no second model server and no fallback backend.
ACTIVITY_VISION_BACKEND=vllm
VLLM_VISION_HOST=http://127.0.0.1:8001
VLLM_MODEL_ID=cyankiwi/Qwen3-VL-8B-Instruct-AWQ-4bit
VLLM_VISION_MODEL=cyankiwi/Qwen3-VL-8B-Instruct-AWQ-4bit
# Vision and audio are sequenced by stage locks (never execute together) and
# both stay resident: the engine is capped near 11 GB, the audio model near 6 GB.
QWEN_AUDIO_MODEL_ID=Qwen/Qwen2-Audio-7B-Instruct
QWEN_AUDIO_LOAD_IN_4BIT=1
VLLM_GPU_MEMORY_UTILIZATION=0.45
VLLM_MAX_MODEL_LEN=8192
# Idle release: after this many seconds with no API request the engine is put to
# sleep and the audio model is unloaded, freeing the GPU for other containers.
# The next request wakes them automatically. 0 disables idling.
VLLM_IDLE_SLEEP_SECONDS=60
VLLM_MM_MAX_PIXELS=200704
VLLM_MM_NFRAMES=8
MAX_CRUCIAL_FRAMES=6
CRUCIAL_FRAME_SCORE_THRESHOLD=0.08
CRUCIAL_FRAME_MIN_GAP_SECONDS=0.75
REPORTS_HOST_PATH=/home/demo/projects/activity_recog_v2/reports
MAX_VIDEO_FRAMES=0
FRAME_INTERVAL_SECONDS=1
ENABLE_AUDIO_ANALYSIS=0
DB_NAME=isquare
DB_USER=postgres
DB_PASSWORD=change-me
DB_HOST=host.docker.internal
DB_PORT=5432

# The app is pinned to exactly one GPU through CUDA_VISIBLE_DEVICES, resolved
# with CUDA_DEVICE_ORDER=PCI_BUS_ID. Default 1 is this host's 24 GB RTX PRO
# 4000 Blackwell (PCI bus 04:00.0); 0 is a 4 GB Quadro K2200 (PCI bus 03:00.0,
# compute capability 5.0) that cannot run these models. List them with
# `nvidia-smi --query-gpu=index,pci.bus_id,name --format=csv`.
GPU_DEVICE_INDEX=1
