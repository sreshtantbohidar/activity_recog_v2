# Copy to .env and fill in the values for your host. Never commit .env.
ACTIVITY_PORT=5009
PRELOAD_MODELS=0
LOG_LEVEL=INFO

# --- vision ---
# One container runs everything: the in-container vLLM engine serves Qwen3-VL-8B
# (int4 AWQ) for vision, and the API runs Qwen2-Audio (4-bit NF4) for audio.
# There is no second model server and no fallback backend.
ACTIVITY_VISION_BACKEND=vllm
VLLM_VISION_HOST=http://127.0.0.1:8001
VLLM_MODEL_ID=cyankiwi/Qwen3-VL-8B-Instruct-AWQ-4bit
VLLM_VISION_MODEL=cyankiwi/Qwen3-VL-8B-Instruct-AWQ-4bit
# Vision and audio are sequenced by stage locks (never execute together) and
# both stay resident: the engine is capped near 11 GB, the audio model near 6 GB.
QWEN_AUDIO_MODEL_ID=Qwen/Qwen2-Audio-7B-Instruct
QWEN_AUDIO_LOAD_IN_4BIT=1
VLLM_GPU_MEMORY_UTILIZATION=0.45
VLLM_MAX_MODEL_LEN=8192
VLLM_MM_MAX_PIXELS=200704
VLLM_MM_NFRAMES=8

# --- idle GPU release ---
# After this many seconds with no API request the engine is put to sleep and the
# audio model is unloaded, freeing the GPU for other containers. The next request
# wakes them automatically. 0 disables idling.
VLLM_IDLE_SLEEP_SECONDS=60

# --- gpu pin ---
# The app is pinned to exactly one GPU through CUDA_VISIBLE_DEVICES, resolved
# with CUDA_DEVICE_ORDER=PCI_BUS_ID. Default 1 is this host's 24 GB RTX PRO
# 4000 Blackwell (PCI bus 04:00.0); 0 is a 4 GB Quadro K2200 (PCI bus 03:00.0,
# compute capability 5.0) that cannot run these models. List them with
# `nvidia-smi --query-gpu=index,pci.bus_id,name --format=csv`.
NVIDIA_VISIBLE_DEVICES=all
GPU_DEVICE_INDEX=1

# --- analysis defaults ---
ENABLE_AUDIO_ANALYSIS=0
MAX_VIDEO_FRAMES=0
FRAME_INTERVAL_SECONDS=1
MAX_CRUCIAL_FRAMES=6
CRUCIAL_FRAME_SCORE_THRESHOLD=0.08
CRUCIAL_FRAME_MIN_GAP_SECONDS=0.75
MAX_UPLOAD_BYTES=209715200
MAX_VIDEO_DURATION_SECONDS=300
# 0 accepts the self-signed certificate of an internal media server.
MEDIA_TLS_VERIFY=0

# --- reports ---
REPORTS_HOST_PATH=./reports

# --- queue ---
JOB_HISTORY_LIMIT=200
JOB_MAX_PENDING=32
JOB_RESPONSE_MAX_CHARS=262144
JOB_RESPONSE_PREVIEW_CHARS=2000
JOB_REPLAY_RETENTION=10
JOB_REPLAY_MAX_BYTES=1073741824
JOB_PAGE_SIZE=25
JOB_PAGE_SIZE_MAX=200

# --- postgres target (needed only for the database-driven route) ---
DB_NAME=isquare
DB_USER=postgres
DB_PASSWORD=change-me
DB_HOST=host.docker.internal
DB_PORT=5432

# --- sftp delivery for the database-driven /detect-objects mode ---
SFTP_HOST=
SFTP_PORT=22
SFTP_USER=
SFTP_PRIVATE_KEY_PATH=/app/secrets/id_ed25519
SFTP_REMOTE_DIR=
OUTPUT_PUBLIC_BASE=
OUTPUT_PUBLIC_PATH=

# --- local test material (bind-mounted read-only at /testvideos) ---
TEST_VIDEOS_DIR=./testvideos
