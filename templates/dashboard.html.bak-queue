<!doctype html>
<html lang="en"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1">
<title>Activity Recognition Console</title><style>
:root{color-scheme:dark;--bg:#07111f;--panel:#101e30;--line:#263b53;--accent:#44d7b6;--muted:#94a8bd}
*{box-sizing:border-box}html,body{max-width:100%;overflow-x:hidden}body{margin:0;font:15px system-ui;background:radial-gradient(circle at 20% 0,#17375a,var(--bg) 45%);color:#eef7ff;min-height:100vh}
main{width:min(1100px,100%);margin:auto;padding:40px 20px}.top{display:grid;grid-template-columns:minmax(0,1fr) minmax(220px,auto);gap:24px;align-items:center}.top>div{min-width:0}.service{text-align:right}h1{font-size:clamp(28px,5vw,48px);line-height:1.08;margin:.2em 0;overflow-wrap:anywhere}.badge{display:inline-block;max-width:100%;padding:8px 12px;border:1px solid var(--line);border-radius:20px;color:var(--accent);overflow-wrap:anywhere}.service a{display:inline-block;margin-top:12px}
.tabs{display:flex;gap:8px;margin-top:28px;overflow-x:auto;padding-bottom:4px}.tab{flex:0 0 auto;margin:0;background:#101e30;color:#cfe2f3;border:1px solid var(--line)}.tab.active{background:var(--accent);color:#042019;border-color:var(--accent)}.tab:disabled{cursor:not-allowed;opacity:.42}.grid{display:grid;grid-template-columns:minmax(0,1fr) minmax(0,1fr);gap:20px;margin-top:14px;align-items:start}.card{min-width:0;overflow:hidden;background:#101e30e8;border:1px solid var(--line);border-radius:18px;padding:24px;box-shadow:0 18px 50px #0005}.backend-row{display:grid;grid-template-columns:minmax(0,1fr) minmax(150px,auto);gap:10px;align-items:center;margin:14px 0}.backend-row select,.config-grid input{display:block;width:100%;padding:10px;border:1px solid var(--line);border-radius:9px;background:#07111f;color:#eef7ff}.config-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:12px}.config-grid label{display:grid;gap:5px;color:var(--muted);font-size:13px}.drop{display:block;width:100%;border:2px dashed #395777;border-radius:12px;padding:34px 16px;text-align:center;color:var(--muted);cursor:pointer;overflow-wrap:anywhere}.drop.drag{border-color:var(--accent);background:#44d7b611}.drop.busy{pointer-events:none;opacity:.5;cursor:not-allowed}#file{display:none}button{background:var(--accent);color:#042019;border:0;border-radius:9px;padding:11px 18px;font-weight:700;cursor:pointer;margin-top:14px}button:disabled{opacity:.5}#media{width:100%;overflow:hidden}.preview{display:block;width:100%;height:auto;max-height:280px;object-fit:contain;margin-top:16px;border-radius:10px;background:#07111f}pre{width:100%;margin:0;white-space:pre-wrap;overflow-wrap:anywhere;word-break:break-word;background:#07111f;padding:16px;border-radius:10px;min-height:220px;max-height:520px;overflow:auto;color:#cfe2f3}.report-link{display:inline-block;margin-bottom:12px;padding:10px 14px;border-radius:9px;background:#44d7b61c;border:1px solid var(--accent);font-weight:700}.meta{max-width:100%;color:var(--muted);overflow-wrap:anywhere}a{color:var(--accent)}
@media(max-width:760px){main{padding:24px 14px}.top,.grid{grid-template-columns:minmax(0,1fr)}.top{align-items:start}.service{text-align:left}.card{padding:18px}.drop{padding:28px 12px}}@media(max-width:480px){.backend-row{grid-template-columns:minmax(0,1fr)}.badge{border-radius:12px}.card{padding:14px}}
</style></head><body><main><div class="top"><div><div class="meta">VISION OPERATIONS</div><h1>Activity Recognition Console</h1><div class="meta">Upload an image or video (maximum {{ max_upload_mb }} MB) and inspect the API response.</div></div><div class="service"><span id="health" class="badge">Checking service…</span><br><a href="/docs/" target="_blank">Open Swagger docs ↗</a></div></div>
<nav class="tabs" role="tablist" aria-label="Inference features"><button class="tab active" data-mode="image" role="tab">Image Analysis</button><button class="tab" data-mode="video" role="tab">Video Analysis</button><button class="tab" data-mode="temporal" role="tab">Detailed Video</button><button class="tab" data-mode="objects" role="tab">Object Detection</button><button class="tab" data-mode="config" role="tab">Configuration</button></nav>
<div class="grid"><section class="card"><h2 id="featureTitle">Image Analysis</h2><p id="featureHelp" class="meta">Analyze scene content and classified activity with Qwen3-VL.</p><div id="uploadPanel"><label id="drop" class="drop" for="file"><strong id="dropTitle">Drop an image here</strong><br><span>or click to browse</span></label><input id="file" type="file" accept="image/*"><div id="media"></div><button id="run" disabled>Run image analysis</button></div><form id="configPanel" hidden><div class="config-grid"><label>Max video frames (0 = unlimited)<input name="MAX_VIDEO_FRAMES" type="number" min="0" max="100000"></label><label>Frame interval (sec)<input name="FRAME_INTERVAL_SECONDS" type="number" min="0.25" max="30" step="0.25"></label><label>Extra crucial frames<input name="MAX_CRUCIAL_FRAMES" type="number" min="0" max="24"></label><label>Crucial change threshold<input name="CRUCIAL_FRAME_SCORE_THRESHOLD" type="number" min="0" max="1" step="0.01"></label><label>Crucial frame gap (sec)<input name="CRUCIAL_FRAME_MIN_GAP_SECONDS" type="number" min="0.1" max="30" step="0.1"></label><label>Audio window (sec)<input name="AUDIO_EVENT_WINDOW_SECONDS" type="number" min="1" max="60"></label><label>Audio overlap (sec)<input name="AUDIO_EVENT_OVERLAP_SECONDS" type="number" min="0" max="59"></label><label>Audio confidence<input name="AUDIO_EVENT_CONFIDENCE_THRESHOLD" type="number" min="0" max="1" step="0.01"></label><label>Object confidence<input name="OBJECT_CONFIDENCE" type="number" min="0" max="1" step="0.01"></label><label>Object image size<input name="OBJECT_IMAGE_SIZE" type="number" min="256" max="1280" step="32"></label><label>Max video duration (sec)<input name="MAX_VIDEO_DURATION_SECONDS" type="number" min="1" max="3600"></label><label class="toggle-row"><input name="REPORTING_ENABLED" type="checkbox" value="1"> PDF report generation</label></div><button type="submit">Save configuration</button></form><p id="status" class="meta"></p></section><section class="card"><h2>Result</h2><div id="reportLink"></div><pre id="result">Waiting for a file…</pre></section></div></main>
<script>
const file=document.querySelector('#file'),drop=document.querySelector('#drop'),run=document.querySelector('#run'),result=document.querySelector('#result'),statusEl=document.querySelector('#status'),media=document.querySelector('#media'),featureTitle=document.querySelector('#featureTitle'),featureHelp=document.querySelector('#featureHelp'),dropTitle=document.querySelector('#dropTitle'),reportLink=document.querySelector('#reportLink'),uploadPanel=document.querySelector('#uploadPanel'),configPanel=document.querySelector('#configPanel');let selected,mode='image';
const modes={image:{title:'Image Analysis',help:'Analyze scene content and classified activity with Qwen3-VL.',accept:'image/*',drop:'Drop an image here',button:'Run image analysis',endpoint:'/analyze-image'},video:{title:'Video Analysis',help:'Sample video frames and return timestamped activity evidence with audio analysis.',accept:'video/*',drop:'Drop a video here',button:'Run video analysis',endpoint:'/analyze-video'},temporal:{title:'Detailed Video Analysis',help:'Run persistent object tracking, Qwen3-VL frame evidence, motion rhythm, and audio analysis.',accept:'video/*',drop:'Drop a video here',button:'Run detailed video analysis',endpoint:'/analyze-video-detailed'},objects:{title:'Object Detection',help:'Detect and localize objects in an image with the dedicated YOLO model.',accept:'image/*',drop:'Drop an image here',button:'Run object detection',endpoint:'/detect-objects'},config:{title:'Configuration',help:'Tune and persist sampling, audio-window, overlap, crucial-frame, and object-detection settings.'}};
function setBusy(busy){document.querySelectorAll('.tab').forEach(x=>x.disabled=busy);file.disabled=busy;drop.classList.toggle('busy',busy);run.disabled=busy||!selected;run.textContent=busy?'Inference running…':modes[mode].button;document.querySelector('#health').textContent=busy?`${mode} inference running · controls locked`:document.querySelector('#health').dataset.idle||'ready'}
fetch('/health').then(r=>r.json()).then(x=>{const h=document.querySelector('#health');h.dataset.idle=`${x.status} · ${x.primary_backend} · ${x.vision_model}`;h.textContent=h.dataset.idle}).catch(()=>document.querySelector('#health').textContent='unavailable');
function choose(f){selected=f;run.disabled=!f;media.innerHTML='';if(!f)return;const isVideo=f.type.startsWith('video');const u=URL.createObjectURL(f),e=document.createElement(isVideo?'video':'img');e.src=u;e.className='preview';if(e.tagName==='VIDEO')e.controls=true;media.append(e);statusEl.textContent=`${f.name} · ${(f.size/1048576).toFixed(1)} MB`;}
async function loadConfig(){const response=await fetch('/config'),data=await response.json();Object.entries(data.configuration||{}).forEach(([key,value])=>{const field=configPanel.elements.namedItem(key);if(field)field.value=value});result.textContent=JSON.stringify(data,null,2)}
document.querySelectorAll('.tab').forEach(tab=>tab.onclick=()=>{mode=tab.dataset.mode;document.querySelectorAll('.tab').forEach(x=>x.classList.toggle('active',x===tab));const config=modes[mode];featureTitle.textContent=config.title;featureHelp.textContent=config.help;const isConfig=mode==='config';uploadPanel.hidden=isConfig;configPanel.hidden=!isConfig;if(isConfig){loadConfig().catch(e=>result.textContent=String(e));return}dropTitle.textContent=config.drop;run.textContent=config.button;file.accept=config.accept;file.value='';selected=undefined;run.disabled=true;media.innerHTML='';reportLink.innerHTML='';statusEl.textContent='';result.textContent='Waiting for a file…';});
configPanel.onsubmit=async e=>{e.preventDefault();setBusy(true);const payload={};new FormData(configPanel).forEach((value,key)=>payload[key]=Number(value));const reportingBox=configPanel.elements.namedItem('REPORTING_ENABLED');if(reportingBox)payload.REPORTING_ENABLED=reportingBox.checked?1:0;try{const response=await fetch('/config',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify(payload)}),data=await response.json();result.textContent=JSON.stringify(data,null,2);statusEl.textContent=response.ok?'Configuration saved and applied.':'Configuration was rejected.'}catch(error){result.textContent=String(error)}finally{setBusy(false)}};
file.onchange=()=>choose(file.files[0]);['dragenter','dragover'].forEach(x=>drop.addEventListener(x,e=>{e.preventDefault();drop.classList.add('drag')}));['dragleave','drop'].forEach(x=>drop.addEventListener(x,e=>{e.preventDefault();drop.classList.remove('drag')}));drop.ondrop=e=>choose(e.dataTransfer.files[0]);
run.onclick=async()=>{if(!selected)return;setBusy(true);reportLink.innerHTML='';result.textContent='Running inference…';const body=new FormData();body.append('file',selected);const started=performance.now();try{const response=await fetch(modes[mode].endpoint,{method:'POST',body});const data=await response.json();result.textContent=JSON.stringify(data,null,2);const report=data?.analysis?.report;if(report?.download_url){const link=document.createElement('a');link.href=report.download_url;link.className='report-link';link.download=report.filename;link.textContent='Download detailed PDF report';reportLink.append(link)}statusEl.textContent=`${selected.name} · ${(selected.size/1048576).toFixed(1)} MB · ${((performance.now()-started)/1000).toFixed(1)} s · HTTP ${response.status}`;}catch(e){result.textContent=String(e)}finally{setBusy(false)}};
</script></body></html>
